{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.face",
    "height": 11,
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "                  \u001b[36m󰌢  [ SYSTEM INFO ]"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "    OS",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "  󰏗  Packages",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "    WM",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "    Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "    User"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "    CPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "  󰘚  Memory",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "  󰅐  Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "               \u001b[30m󰊠  \u001b[31m󰊠  \u001b[32m󰊠  \u001b[33m󰊠  \u001b[34m󰊠  \u001b[35m󰊠  \u001b[36m󰊠  \u001b[37m󰊠  \u001b[0m"
    }
  ]
}
